  - m_Id: 1521467953152
    m_Localized: "\u041C\u0443\u0437\u0438\u043A\u0430:"
    m_Metadata:
      m_Items: []
  - m_Id: 1654112817152
    m_Localized: "\u0406\u0433\u0440\u043E\u0432\u0456 \u0437\u0432\u0443\u043A\u0438:"
    m_Metadata:
      m_Items: []
  - m_Id: 1846501347328
    m_Localized: "\u0410\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1897155956736
    m_Localized: "\u0413\u0440\u0443\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 52571067551744
    m_Localized: "\u0421\u0438\u043B\u044C\u043D\u0438\u0439 \u0442\u0430 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043B\u0438\u0439
      \u0432\u043E\u0457\u043D, \u0432\u0438\u0445\u043E\u0434\u0435\u0446\u044C
      \u0456\u0437 \u043F\u0456\u0432\u043D\u0456\u0447\u043D\u0438\u0445 \u0437\u0435\u043C\u0435\u043B\u044C,
      \u0434\u0435 \u0437\u043C\u0430\u043B\u043A\u0443 \u043F\u0440\u0438\u0432\u0447\u0435\u043D\u0438\u0439
      \u0434\u043E \u0441\u0443\u0432\u043E\u0440\u0438\u0445 \u0443\u043C\u043E\u0432
      \u0456 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E\u0457 \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0438.
      \u041E\u0437\u0431\u0440\u043E\u0454\u043D\u0438\u0439 \u0432\u0430\u0436\u043A\u0438\u043C
      \u043C\u0435\u0447\u0435\u043C \u0456 \u0437\u0430\u043B\u0456\u0437\u043D\u0438\u043C
      \u0449\u0438\u0442\u043E\u043C, \u0432\u0456\u043D \u0440\u043E\u0431\u0438\u0442\u044C
      \u0441\u0442\u0430\u0432\u043A\u0443 \u043D\u0430 \u0441\u0438\u043B\u0443
      \u0439 \u043F\u0440\u044F\u043C\u043E\u043B\u0456\u043D\u0456\u0439\u043D\u0456\u0441\u0442\u044C
      \u0443 \u0431\u043E\u044E. \u0413\u0440\u0443\u0441 \u043D\u0435 \u043D\u0430\u0434\u0442\u043E
      \u043B\u044E\u0431\u0438\u0442\u044C \u0445\u0438\u0442\u0440\u043E\u0449\u0456,
      \u0430\u043B\u0435 \u0432\u043C\u0456\u0454 \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u0438
      \u043A\u043C\u0456\u0442\u043B\u0438\u0432\u0456\u0441\u0442\u044C, \u043A\u043E\u043B\u0438
      \u0446\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0434\u043B\u044F
      \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F. \u0419\u043E\u0433\u043E
      \u0436\u0438\u0442\u0442\u044F \u2014 \u0446\u0435 \u0448\u043B\u044F\u0445
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438 \u0456\u043D\u0448\u0438\u043C,
      \u0434\u043E\u0432\u0433\u0456 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0456
      \u0456 \u0437\u0456\u0442\u043A\u043D\u0435\u043D\u044C \u0456\u0437 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u043C\u0438.
      \u041F\u0456\u0441\u043B\u044F \u0432\u0438\u043A\u0440\u0430\u0434\u0435\u043D\u043D\u044F
      \u0410\u0440\u0438 \u0432\u0456\u043D \u0433\u043E\u0442\u043E\u0432\u0438\u0439
      \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u0438\u0441\u044F \u0443 \u043D\u0430\u0439\u0433\u043B\u0438\u0431\u0448\u0456
      \u043F\u0430\u0441\u0442\u043A\u0438 \u043F\u0456\u0434\u0437\u0435\u043C\u0435\u043B\u043B\u044F,
      \u0449\u043E\u0431 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u0441\u0432\u043E\u044E
      \u043F\u043E\u0434\u0440\u0443\u0433\u0443, \u043D\u0430\u0432\u0456\u0442\u044C
      \u044F\u043A\u0449\u043E \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
      \u0431\u0438\u0442\u0438\u0441\u044F \u0437 \u0456\u0441\u0442\u043E\u0442\u0430\u043C\u0438,
      \u044F\u043A\u0438\u0445 \u0431\u043E\u0457\u0442\u044C\u0441\u044F \u0432\u0435\u0441\u044C
      \u0441\u0432\u0456\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 53219179794432
    m_Localized: "\u0410\u0443\u0434\u0456\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 85526263533568
    m_Localized: "\u0420\u0443\u0445:\n\u0412\u043F\u0440\u0430\u0432\u043E - D\n\u0412\u043B\u0456\u0432\u043E
      - A\n\u0421\u0442\u0440\u0438\u0431\u043E\u043A - W\n\u0411\u0456\u0433 - Shift+D
      / Shift+A\n\n\u0411\u0456\u0439:\n\u0410\u0442\u0430\u043A\u0430 - Mouse1\n\u0411\u043B\u043E\u043A
      - Mouse2"
    m_Metadata:
      m_Items: []
  - m_Id: 858458866749440
    m_Localized: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1148988532101120
    m_Localized: "\u041F\u0430\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1149444285173760
    m_Localized: "\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0442\u0430 \u0432\u0438\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1230359602565120
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u0430, \u0441\u043F\u0440\u0438\u0442\u043D\u0430
      \u0435\u043B\u044C\u0444\u0456\u0439\u043A\u0430, \u0449\u043E \u0432\u0438\u0440\u043E\u0441\u043B\u0430
      \u0432 \u0433\u0456\u0440\u0441\u044C\u043A\u043E\u043C\u0443 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u043D\u0456,
      \u0434\u0435 \u0437 \u0434\u0438\u0442\u0438\u043D\u0441\u0442\u0432\u0430
      \u043D\u0430\u0432\u0447\u0438\u043B\u0430\u0441\u044F \u043F\u043E\u0454\u0434\u043D\u0443\u0432\u0430\u0442\u0438
      \u043C\u0430\u0433\u0456\u044E \u0442\u0430 \u0442\u0430\u043A\u0442\u0438\u0447\u043D\u0438\u0439
      \u0440\u043E\u0437\u0443\u043C. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454
      \u043F\u043E\u0441\u043E\u0445 \u0456 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u0439
      \u0441\u0444\u0435\u0440\u0438\u0447\u043D\u0438\u0439 \u0449\u0438\u0442,
      \u0449\u043E \u0437\u0434\u0430\u0442\u0435\u043D \u0432\u0456\u0434\u0431\u0438\u0432\u0430\u0442\u0438
      \u044F\u043A \u0444\u0456\u0437\u0438\u0447\u043D\u0456, \u0442\u0430\u043A
      \u0456 \u043C\u0430\u0433\u0456\u0447\u043D\u0456 \u0430\u0442\u0430\u043A\u0438.
      \u0410\u0440\u0430 \u0437\u0430\u0432\u0436\u0434\u0438 \u043D\u0456\u0436\u043D\u0430
      \u0456 \u043C\u0438\u043B\u0430, \u0430\u043B\u0435 \u0432\u043C\u0456\u0454
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u043A\u0440\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u043D\u0430\u0432\u0456\u0442\u044C \u0443 \u043D\u0430\u0439\u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0438\u0445
      \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044F\u0445. \u0407\u0457 \u0433\u043E\u043B\u043E\u0432\u043D\u0430
      \u043C\u0435\u0442\u0430 \u2014 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0442\u0438
      \u043B\u044E\u0434\u044F\u043C \u0456 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0438
      \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u0456\u0441\u0442\u044C,
      \u043D\u0430\u0432\u0456\u0442\u044C \u044F\u043A\u0449\u043E \u0434\u043B\u044F
      \u0446\u044C\u043E\u0433\u043E \u0442\u0440\u0435\u0431\u0430 \u0439\u0442\u0438
      \u043A\u0440\u0456\u0437\u044C \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0438
      \u043F\u0456\u0434\u0437\u0435\u043C\u0435\u043B\u044C. \u041A\u043E\u043D\u0444\u043B\u0456\u043A\u0442
      \u0456\u0437 \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u0442\u043D\u0435\u043C
      \u0441\u0442\u0430\u0432 \u0434\u043B\u044F \u043D\u0435\u0457 \u043D\u0435
      \u043B\u0438\u0448\u0435 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F\u043C
      \u0441\u0438\u043B\u0438, \u0430 \u0439 \u0448\u0430\u043D\u0441\u043E\u043C
      \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043E\u0433\u043E
      \u0442\u043E\u0432\u0430\u0440\u0438\u0448\u0430 \u0442\u0430 \u0440\u043E\u0437\u043A\u0440\u0438\u0442\u0438
      \u0442\u0430\u0454\u043C\u043D\u0438\u0446\u0456 \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u044C\u043E\u0433\u043E
      \u0437\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1231170013401088
    m_Localized: "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044C \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2390594891452416
    m_Localized: "\u0417\u0434\u043E\u0440\u043E\u0432'\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2390702567624704
    m_Localized: "\u0410\u0442\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2390721223888896
    m_Localized: "\u0411\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2390901427965952
    m_Localized: "\u041E\u0447\u043A\u0438 \u0434\u043E\u0441\u0432\u0456\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2395189063618560
    m_Localized: "\u0429\u043E\u0431 \u0445\u043E\u0434\u0438\u0442\u0438, \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \xABA\xBB \u0430\u0431\u043E \xABD\xBB\n\u0430 \u0449\u043E\u0431 \u0431\u0456\u0433\u0442\u0438
      \u0437\u0430\u0436\u043C\u0456\u0442\u044C \u0449\u0435 \u0439 \"Shift\""
    m_Metadata:
      m_Items: []
  - m_Id: 2395907304624128
    m_Localized: "\u0429\u043E\u0431 \u0441\u0442\u0438\u0431\u043D\u0443\u0442\u0438
      \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \"Space\""
    m_Metadata:
      m_Items: []
  - m_Id: 2403577927471104
    m_Localized: "\u0429\u043E\u0431 \u0430\u0442\u0430\u043A\u0443\u0432\u0430\u0442\u0438
      \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \"left-click\", \n\u0430
      \u0449\u043E\u0431 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0431\u043B\u043E\u043A
      \"right-click\""
    m_Metadata:
      m_Items: []
  - m_Id: 2405953631588352
    m_Localized: "\u041E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0439\u0441\u044F
      \u043F\u0430\u0441\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2728962191953920
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C 1"
    m_Metadata:
      m_Items: []
  - m_Id: 2729005783355392
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C 2"
    m_Metadata:
      m_Items: []
  - m_Id: 2729026704543744
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C 3"
    m_Metadata:
      m_Items: []
  - m_Id: 2729058291847168
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C 4"
    m_Metadata:
      m_Items: []
  - m_Id: 2729074846765056
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C 5"
    m_Metadata:
      m_Items: []
  - m_Id: 2737301177143296
    m_Localized: "\u041A\u043E\u043B\u0438 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439
      \u0443\u0434\u0430\u0440 \u043F\u043E \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u0442\u043D\u044E
      \u0431\u0443\u0432 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0439,
      \u0442\u0435\u043C\u0440\u044F\u0432\u0430 \u043F\u043E\u0447\u0430\u043B\u0430
      \u0440\u043E\u0437\u0441\u0456\u044E\u0432\u0430\u0442\u0438\u0441\u044F. \u041F\u0456\u0434\u0437\u0435\u043C\u0435\u043B\u043B\u044F
      \u0437\u0434\u0440\u0438\u0433\u043D\u0443\u043B\u043E\u0441\u044F, \u0430\u043B\u0435
      \u043D\u0435 \u0432\u0456\u0434 \u0433\u043D\u0456\u0432\u0443 \u0447\u0443\u0434\u043E\u0432\u0438\u0441\u044C\u043A\u0430,
      \u0430 \u0432\u0456\u0434 \u0442\u043E\u0433\u043E, \u0449\u043E \u0441\u0442\u0430\u0440\u043E\u0434\u0430\u0432\u043D\u0454
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0442\u044F \u0437\u043D\u0438\u043A\u0430\u043B\u043E
      \u0440\u0430\u0437\u043E\u043C \u0456\u0437 \u043D\u0438\u043C. \u0422\u0456\u043B\u043E
      \u0432\u043E\u0440\u043E\u0433\u0430 \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u043E
      \u0441\u0438\u043B\u0443 \u0439 \u0440\u043E\u0437\u0441\u0438\u043F\u0430\u043B\u043E\u0441\u044F
      \u043F\u043E\u043F\u0435\u043B\u043E\u043C, \u043D\u0456\u0431\u0438 \u0439\u043E\u0433\u043E
      \u043D\u0456\u043A\u043E\u043B\u0438 \u0439 \u043D\u0435 \u0431\u0443\u043B\u043E.\n\n\u0417\u0430\u043B\u0438\u0448\u0435\u043D\u0438\u0439
      \u0443 \u043F\u043E\u043B\u043E\u043D\u0456 \u0442\u043E\u0432\u0430\u0440\u0438\u0448
      \u0437\u2019\u044F\u0432\u0438\u0432\u0441\u044F \u043F\u0435\u0440\u0435\u0434
      \u0433\u0440\u0430\u0432\u0446\u0435\u043C \u2014 \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u0438\u0439,
      \u0430\u043B\u0435 \u0436\u0438\u0432\u0438\u0439. \u0412\u043E\u043D\u0438
      \u0437\u0443\u0441\u0442\u0440\u0456\u043B\u0438\u0441\u044F \u043F\u043E\u0433\u043B\u044F\u0434\u043E\u043C,
      \u0456 \u0432\u0436\u0435 \u043D\u0435 \u0431\u0443\u043B\u043E \u043F\u043E\u0442\u0440\u0435\u0431\u0438
      \u0432 \u0441\u043B\u043E\u0432\u0430\u0445: \u043A\u043E\u0436\u0435\u043D
      \u0440\u043E\u0437\u0443\u043C\u0456\u0432, \u0449\u043E \u0457\u0445\u043D\u0456\u0439
      \u0437\u0432\u2019\u044F\u0437\u043E\u043A \u043C\u0456\u0446\u043D\u0456\u0448\u0438\u0439
      \u0437\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0435 \u0437\u043B\u043E.\n\n\u041F\u0435\u0447\u0435\u0440\u0430
      \u043E\u0441\u0432\u0456\u0442\u043B\u0438\u043B\u0430\u0441\u044F \u043C\u2019\u044F\u043A\u0438\u043C
      \u0441\u044F\u0439\u0432\u043E\u043C \u2014 \u0442\u0435, \u0449\u043E \u0449\u0435
      \u0445\u0432\u0438\u043B\u0438\u043D\u0443 \u0442\u043E\u043C\u0443 \u0431\u0443\u043B\u043E
      \u043F\u043E\u0445\u043C\u0443\u0440\u0438\u043C \u043F\u0456\u0434\u0437\u0435\u043C\u0435\u043B\u043B\u044F\u043C,
      \u0442\u0435\u043F\u0435\u0440 \u043D\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043B\u043E
      \u0445\u0440\u0430\u043C, \u0434\u0435 \u043D\u0430\u0432\u0456\u0442\u044C
      \u043A\u0430\u043C\u0456\u043D\u043D\u044F \u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0432\u0430\u043B\u043E
      \u0441\u043F\u043E\u043A\u0456\u0439. \u0412\u0438\u0445\u0456\u0434 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0441\u044F
      \u0441\u0430\u043C \u0441\u043E\u0431\u043E\u044E.\n\n\u0412\u0438\u0431\u0440\u0430\u0432\u0448\u0438\u0441\u044C
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u044E, \u0410\u0440\u0430
      \u0439 \u0413\u0440\u0443\u0441 \u0437\u043D\u043E\u0432\u0443 \u0432\u0434\u0438\u0445\u043D\u0443\u043B\u0438
      \u0441\u0432\u0456\u0436\u0435 \u043F\u043E\u0432\u0456\u0442\u0440\u044F.
      \u041F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C\u0438 \u0440\u043E\u0437\u043A\u0438\u043D\u0443\u0432\u0441\u044F
      \u0441\u0432\u0456\u0442\u0430\u043D\u043E\u043A \u2014 \u043F\u0435\u0440\u0448\u0438\u0439
      \u043F\u0456\u0441\u043B\u044F \u0434\u043E\u0432\u0433\u0438\u0445 \u043D\u043E\u0447\u0435\u0439
      \u0443 \u043F\u0456\u0442\u044C\u043C\u0456. \u041E\u0431\u043E\u0454 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0438,
      \u0449\u043E \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u0435 \u0437\u043C\u0456\u043D\u0438\u043B\u043E
      \u0457\u0445 \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438: \u0442\u0435\u043F\u0435\u0440
      \u0432\u043E\u043D\u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u043A\u0438, \u0449\u043E
      \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u044E\u0442\u044C \u043B\u044E\u0434\u044F\u043C,
      \u0430 \u0442\u0456, \u0445\u0442\u043E \u0437\u0434\u0430\u0442\u0435\u043D
      \u043F\u043E\u0434\u043E\u043B\u0430\u0442\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0434\u0430\u0432\u043D\u0454 \u0437\u043B\u043E.\n\n\u0407\u0445\u043D\u0456\u0439
      \u0448\u043B\u044F\u0445 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0454\u0442\u044C\u0441\u044F
      \u2014 \u0430\u043B\u0435 \u0442\u0435\u043F\u0435\u0440 \u0443\u0436\u0435
      \u0440\u0430\u0437\u043E\u043C, \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0443
      \u0432\u0442\u0440\u0430\u0442\u0438\u0442\u0438 \u043E\u0434\u043D\u0435 \u043E\u0434\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2739721353465856
    m_Localized: "\u0429\u043E\u0431 \u0432\u0438\u0439\u0442\u0438 \u0433\u043E\u043B\u043E\u0432\u043D\u0435
      \u043C\u0435\u043D\u044E \u043D\u0430\u0436\u043C\u0456\u0442\u044C \"ESC\""
    m_Metadata:
      m_Items: []
  - m_Id: 2743311551860736
    m_Localized: "\u0414\u044F\u043A\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2743410206085120
    m_Localized: "\u0414\u044F\u043A\u0443\u044E,\u0449\u043E \u0442\u0438 \u0437\u0430\u0439\u0448\u043E\u0432
      \u0432 \u0446\u044E \u0433\u0440\u0443,\n\u041D\u0430\u0434\u0456\u044E\u0441\u044C
      \u0432\u043E\u043D\u0430 \u0442\u043E\u0431\u0456 \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u043B\u0430\u0441\u044F,
      \u0430\u0431\u043E \u044F\u043A\u0449\u043E \u0442\u0438 \u0449\u0435 \u043D\u0435
      \u0433\u0440\u0430\u0432 \u0442\u043E \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F.\n\u041D\u0430\u0434
      \u0433\u0440\u043E\u044E \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0438:\n\u0422\u0440\u0443\u0442
      \u0420\u043E\u043C\u0430\u043D\n\u041F\u0440\u043E\u0446\u0430\u043D\u0456\u043D
      \u0414\u0430\u043D\u0438\u043B\u043E\n\u0420\u043E\u043C\u0430\u043D\n\u0410\u043D\u043D\u0430\n\u0404\u043B\u0438\u0437\u0430\u0432\u0435\u0442\u0430\n\u0404\u0432\u0433\u0435\u043D\u0456\u044F\n\n\u0429\u0435
      \u0440\u0430\u0437 \u0434\u044F\u043A\u0443\u044E\u2665"
    m_Metadata:
      m_Items: []
  - m_Id: 2756996534013952
    m_Localized: "\u041D\u0435 \u0437\u0430\u0431\u0443\u0432\u0430\u0439 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438\u0441\u044F
      \u043F\u0435\u0440\u0435\u0434 \u043F\u0440\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F\u043C
      \u0440\u0456\u0432\u043D\u044F"
